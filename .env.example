# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 排除，不会进仓库。
# 也可以直接用环境变量传入 —— 环境变量优先级高于 .env。

# ── CF Worker 临时邮箱（必填）─────────────────────────────────────
# 复用 Intern-Register-Tool 那台 Worker（实测可收 hark 邮件，
# 发件域 mailer.hark.com，主题 "Your Hark sign-in link"）。
#
# 🔴 为什么这两项没有默认值：本仓库是公开的，写死等于把邮箱服务的
#    管理凭据 + 自有域名一起交出去。缺了会在**启动阶段**报错（config.validate），
#    而不是带着空 base 去发一堆注定失败的请求。
HR_WORKER_BASE=
HR_WORKER_ADMIN_TOKEN=
HR_WORKER_DOMAIN=

# ── Hark 站点（一般不用改）───────────────────────────────────────
# 站点 API 与 auth API 是**两个域名**：前者 hark.com，后者 auth.hark.com。
# 实测两者都能读 session（cookie 域是 .hark.com），但 magic link 的
# 校验端点只在 auth.hark.com 上，所以注册链路必须跨这两个 host。
# HR_HARK_BASE=https://hark.com
# HR_AUTH_BASE=https://auth.hark.com

# ── 注册资料 ──────────────────────────────────────────────────────
# 生日决定**年龄门**：实测 age >= 18 才 accepted，
# 未满 18 会被要求绑卡（CARD_VERIFICATION_REQUIRED）。
# 默认取一个显然成年的日期，别改到 18 岁以下。
# HR_BIRTHDAY=1995-01-01
# 密码长度（>= 8，服务端硬要求 PASSWORD_TOO_SHORT）。
# HR_PASSWORD_LEN=20

# ── 本地注册配额保护 ──────────────────────────────────────────────
# 🔴 这是**本地保守保护**，不是服务端权威计量（换机器 / 删 state/ 即重置）。
#    hark 侧的真实限额**尚未测出**（本仓库 docs/protocol.md 记了已测到的部分），
#    所以默认值刻意取得很小 —— 宁可多拦，不可漏拦。
# HR_REG_QUOTA_MAX=20
# HR_REG_QUOTA_WINDOW_H=24

# ── 行为参数（一般不用改）─────────────────────────────────────────
# 收信轮询间隔。实测 hark 的 magic link 邮件在注册后 **1~3s** 到达
# （两次实测是 261ms / 285ms），而单次 `/api/inbox` 往返约 0.3~0.6s。
# HR_MAIL_POLL_INTERVAL=0.8
# HR_MAIL_POLL_TIMEOUT=120
#
# 🔴 注册申请的限速：**按出口**的滑动窗口（与登录侧同构）。
# 实测（tools/probes/probe_register_limit.py）：限的是 `magic-link` 这一个
# 端点，**按 IP**，同出口第 6 次就 429；换域名仍 429、换出口立刻通过。
# 默认 4 次 / 60s 略保守于观测到的 ~5 次。
# HR_REGISTER_MAX_PER_WINDOW=4
# HR_REGISTER_WINDOW_S=60
# HR_REQUEST_TIMEOUT=30

# ── 登录限流（🔴 实测：sign-in/email 约 3 次 / 10s）────────────────
# 这是本项目**唯一**测出准确数字的服务端限流。方法：同一账号连打 5 次，
# 第 1、2、3 次 200，第 4、5 次 `429 RATE_LIMITED: Too many requests.`
# （每个请求本身要 ~2.1s ⇒ 前三次落在同一个 10s 窗口内）。
#
# 它必须被当成**硬约束**：`--workers 4` 会让 4 个账号在 ~2s 内各登录一次，
# 第 4 个必然 429 —— 而 429 会被下游读成「账号坏了」，那是一个**假阴性**。
# 所以消费者侧有滑动窗口限速 + 429 退避重试（见 src/pipeline.py）。
# HR_LOGIN_MAX_PER_WINDOW=3
# HR_LOGIN_WINDOW_S=10
# HR_LOGIN_RETRIES=3

# ── 出口代理（可选）───────────────────────────────────────────────
# 只有 hark 侧需要时可挂；邮箱 Worker 默认直连（CF Worker 不关心我们的出口 IP）。
#   HR_PROXY=host:port:user:pass
#   HR_PROXY=http://user:pass@host:port
# HR_PROXY=
# 收信轮询是否也走代理（默认否）。轮询是整链瓶颈，绕代理只会更慢。
# HR_PROXY_MAIL=0

# ── 槽位代理池（多出口并发）────────────────────────────────
# 🔴 理由与 Intern-Register-Tool **不同**：那边绕的是 IP 维度的**注册封禁**；
#    hark 侧至今没有任何封禁证据。这里的理由是一条**实测数字**：
#    `sign-in/email` 限流 **3 次 / 10s**，而 better-auth 是按**客户端 IP** 计的
#    ⇒ 每个出口各有一张窗口，5 个出口 = 15 次/10s。
#    只调大 --workers 是没用的：那是同一张窗口里的三个名额。
#
# 实测（2026-10-08）：5 个 mihomo 槽位，出口 IP 两两不同且**稳定**
# （每个槽位连打 4 次都是同一个 IP），hark 可达。
#   拉起：Intern-Register-Tool 的 `tools/ops/proxypool_ctl.py start`
#   体检：`python tools/probes/probe_slots.py`
#
# 文件里一行一个或逗号分隔都行，`#` 开头是注释。
# HR_PROXY_SLOTS=http://127.0.0.1:7901,http://127.0.0.1:7902
# HR_PROXY_SLOTS_FILE=.slots.txt
# 等一个空闲出口最多等多久（秒）。全忙时 acquire() 会阻塞，超时按 network 记。
# HR_PROXY_SLOT_TIMEOUT=240

# ── Cloudflare 运维体检（可选，只给 tools/ops/cf_service_doctor.py 用）──
# 🔴 这是**账户级** API Token（`cfat_` 前缀）。实测：
#      GET /accounts                       → 200（能列出账户）
#      GET /user/tokens/verify             → 401 Invalid API Token
#    后者**不是** token 坏了 —— 账户级 token 本来就调不了用户级端点。
#    判"token 到底能不能用"必须打 `/accounts`，别打 `/user/tokens/verify`
#    （打错了会把一个好好的 token 判死）。
# 只在环境变量 / .env 里给，**不进 .env.example 的真实值**。
# HR_CF_API_TOKEN=
# HR_CF_ACCOUNT_ID=
